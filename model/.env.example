# Copy this file to model/.env and fill real values before running locally.

MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=

ADMIN_USERNAME=noteai_admin
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_PORT=8001

# Optional runtime ports used by docker-compose.yml
PORT=8000

# Cloud database and process safety. DATABASE_URL is supplied by Render
# Postgres. Keep the SQLite paths unset outside isolated local tests.
DATABASE_URL=
NOTEAI_SQLITE_PATH=
NOTEAI_HOT_KEYWORD_DB_PATH=
NOTEAI_CLOUD_RUNTIME=0
NOTEAI_GRACEFUL_SHUTDOWN_SECONDS=30
WEB_CONCURRENCY=1

# Temporary video-frame cache. Render staging mounts a small persistent disk
# at this path so upload -> diagnosis survives a service restart.
NOTEAI_VIDEO_CACHE_DIR=
NOTEAI_VIDEO_CACHE_TTL_SECONDS=21600

# Keep disabled in production unless you explicitly need local billing tests.
NOTEAI_ENABLE_TEST_BILLING=0
CORS_ORIGINS=

# Auditable model cost accounting adopted from the 2026-07-12 official price
# cards. Values are per one million tokens. Provider-generic variables are not
# accepted as strict actual cost because the four active models have different
# prices. Each call persists its price/FX/version snapshot.
NOTEAI_MODEL_PRICE_VERSION=official-2026-07-12
NOTEAI_BILLING_USD_CNY=7.00
NOTEAI_MODEL_PRICE_CLAUDE_HAIKU_4_5_20251001_INPUT_PER_1M_USD=1.00
NOTEAI_MODEL_PRICE_CLAUDE_HAIKU_4_5_20251001_CACHE_READ_PER_1M_USD=0.10
NOTEAI_MODEL_PRICE_CLAUDE_HAIKU_4_5_20251001_CACHE_WRITE_5M_PER_1M_USD=1.25
NOTEAI_MODEL_PRICE_CLAUDE_HAIKU_4_5_20251001_CACHE_WRITE_1H_PER_1M_USD=2.00
NOTEAI_MODEL_PRICE_CLAUDE_HAIKU_4_5_20251001_OUTPUT_PER_1M_USD=5.00
NOTEAI_MODEL_PRICE_CLAUDE_SONNET_4_6_INPUT_PER_1M_USD=3.00
NOTEAI_MODEL_PRICE_CLAUDE_SONNET_4_6_CACHE_READ_PER_1M_USD=0.30
NOTEAI_MODEL_PRICE_CLAUDE_SONNET_4_6_CACHE_WRITE_5M_PER_1M_USD=3.75
NOTEAI_MODEL_PRICE_CLAUDE_SONNET_4_6_CACHE_WRITE_1H_PER_1M_USD=6.00
NOTEAI_MODEL_PRICE_CLAUDE_SONNET_4_6_OUTPUT_PER_1M_USD=15.00
NOTEAI_MODEL_PRICE_KIMI_K2_6_INPUT_PER_1M_RMB=6.50
NOTEAI_MODEL_PRICE_KIMI_K2_6_CACHE_READ_PER_1M_RMB=1.10
NOTEAI_MODEL_PRICE_KIMI_K2_6_OUTPUT_PER_1M_RMB=27.00
NOTEAI_MODEL_PRICE_MOONSHOT_V1_32K_VISION_PREVIEW_INPUT_PER_1M_RMB=5.00
NOTEAI_MODEL_PRICE_MOONSHOT_V1_32K_VISION_PREVIEW_OUTPUT_PER_1M_RMB=20.00

# Production model artifact loading.
# Leave BASE_URL empty when Git LFS has already materialized model/artifacts.
# Set REQUIRED=1 in production so missing/mismatched model files fail startup.
NOTEAI_USE_V04_COMPOSITE=1
NOTEAI_MODEL_ARTIFACT_BASE_URL=
NOTEAI_MODEL_ARTIFACT_S3_BUCKET=
NOTEAI_MODEL_ARTIFACT_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
NOTEAI_MODEL_ARTIFACT_MANIFEST=model/artifacts/model_release_manifest.v04.json
NOTEAI_MODEL_ARTIFACT_REQUIRED=0
NOTEAI_ENABLE_CLOUD_MODEL_MUTATION=0

# Optional fact enrichment for China-local facts.
# Food/dining/local-life: use AMAP_WEB_KEY as the baseline fact source.
# Hotel/travel: use the official meituan-travel CLI when MEITUAN_AI_HUB_TOKEN is configured.
# Leave empty to disable web fact enrichment and fall back to safe wording.
NOTEAI_FACT_SEARCH=0
NOTEAI_FACT_SEARCH_PROVIDER=auto
# Default 0 avoids storing third-party map/search results across requests.
NOTEAI_FACT_SEARCH_CACHE_TTL=0
# Optional local verified facts file. Use user-provided material, official API snapshots, or manual verification.
NOTEAI_LOCAL_VERIFIED_FACTS_PATH=
AMAP_WEB_KEY=
BAIDU_MAP_AK=
TENCENT_MAP_KEY=

# Optional Meituan/Dianping official API credentials.
# AI Hub / Skill tokens can enable skills such as meituan-travel through the official CLI.
MEITUAN_AI_HUB_TOKEN=
MEITUAN_OPEN_TOKEN=
NOTEAI_MEITUAN_TRAVEL_ENABLED=1
NOTEAI_MEITUAN_TRAVEL_TIMEOUT=45
MEITUAN_TRAVEL_CLI=

# mt-tech service-retail skills, e.g. review/store/product/merchant-data queries.
# These credentials are not the baseline food/local-life source; use AMAP for that.
# They are only for specific official API products that grant access to defined business resources.
# Find developerId/signKey in Meituan Developer Center account/API credential pages;
# appAuthToken is issued by the corresponding official app access flow.
MEITUAN_DEVELOPER_ID=
MEITUAN_SIGN_KEY=
MEITUAN_APP_AUTH_TOKEN=

# Legacy/other official API credential shapes; kept only when a specific API doc requires them.
MEITUAN_OPEN_APP_KEY=
MEITUAN_OPEN_APP_SECRET=
MEITUAN_OPEN_SIGN=
MEITUAN_OPEN_AES_KEY=

# Optional overseas/general search fallback.
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Market timing evidence pipeline.
# Production should keep REQUIRED=1: AI diagnosis/generation must use fresh industry trend evidence.
# Run market_timing_worker.py as an independent cloud worker/cron, then expose its JSON snapshot
# via object storage/CDN and set NOTEAI_MARKET_TIMING_SNAPSHOT_URL for API services.
NOTEAI_MARKET_TIMING_REQUIRED=1
NOTEAI_API_STARTS_TREND_SCHEDULER=0
NOTEAI_HOT_KEYWORD_FRESH_HOURS=30
NOTEAI_MARKET_TIMING_SNAPSHOT_URL=
NOTEAI_MARKET_TIMING_REFRESH_URL=
NOTEAI_MARKET_TIMING_REFRESH_TOKEN=
NOTEAI_MARKET_TIMING_FETCH_TIMEOUT=8
NOTEAI_MARKET_TIMING_WORKER_INTERVAL_MINUTES=60
NOTEAI_MARKET_TIMING_MIN_DOMAIN_KEYWORDS=12
# Production hard gate: baseline evidence can keep local demos readable, but
# cloud worker must acquire real XHS evidence for every core domain.
NOTEAI_XHS_FRESHNESS_REQUIRED=1
NOTEAI_XHS_FRESHNESS_DEADLINE_HOUR=7
NOTEAI_XHS_FRESHNESS_DEADLINE_MINUTE=0
# Production xhs-http role requires this exact adapter. Collection remains
# suspended until a separately approved session/configuration smoke.
NOTEAI_XHS_ACQUISITION_ADAPTER=spider_xhs_http
NOTEAI_XHS_COLLECTION_SUSPENDED=1
# Legacy local browser/sidecar settings below are not packaged in production.
NOTEAI_XHS_DOWNLOADER_URL=
NOTEAI_XHS_DOWNLOADER_TIMEOUT=20
NOTEAI_XHS_DOWNLOADER_DETAIL_PATH=/xhs/detail
NOTEAI_XHS_SCROLL_ROUNDS=10
NOTEAI_XHS_SCROLL_WAIT_SECONDS=1.0
NOTEAI_XHS_CHANNEL_SETTLE_SECONDS=3.0
NOTEAI_XHS_SEARCH_DISCOVERY=1
NOTEAI_XHS_SEARCH_SEEDS_PER_CATEGORY=2
NOTEAI_XHS_SEARCH_SCROLL_ROUNDS=3
NOTEAI_XHS_SEARCH_SETTLE_SECONDS=2.0
NOTEAI_MARKET_TIMING_SNAPSHOT_PATH=model/data/market_timing_snapshot.json
NOTEAI_MARKET_TIMING_SNAPSHOT_UPLOAD_URL=
NOTEAI_MARKET_TIMING_SNAPSHOT_UPLOAD_TOKEN=

# Owner-bound private request/result/media storage. Empty means unavailable;
# production media and Durable AI admission fail closed. Use an ECS RAM Role,
# never static AK/SK variables. Endpoint must be the regional internal HTTPS
# endpoint. KEY_EPOCH is a non-secret rotation label, not encryption key data.
NOTEAI_PRIVATE_STORAGE_BACKEND=
NOTEAI_OSS_PRIVATE_BUCKET=
NOTEAI_OSS_REGION=
NOTEAI_OSS_ENDPOINT=
NOTEAI_OSS_RAM_ROLE=
NOTEAI_OSS_KEY_PREFIX=noteai-private
NOTEAI_OSS_KMS_KEY_ID=
NOTEAI_PRIVATE_STORAGE_KEY_EPOCH=
