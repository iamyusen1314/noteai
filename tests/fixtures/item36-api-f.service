[Unit]
Description=NoteAI Production API F
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f noteai-api-f
ExecStart=/usr/bin/docker run --log-driver=local --log-opt=max-size=10m --log-opt=max-file=2 --name noteai-api-f --pull never --user 999:999 --read-only --privileged=false --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 512 --memory 1536m --cpus 2 --tmpfs /tmp:rw,noexec,nosuid,nodev,size=536870912,uid=999,gid=999,mode=1777 --env-file /etc/noteai/api.env --env-file /etc/noteai/private-storage.env --env NOTEAI_RUNTIME_ROLE=api --env NOTEAI_CLOUD_RUNTIME=1 --env NOTEAI_API_STARTS_TREND_SCHEDULER=0 --env NOTEAI_MODEL_ARTIFACT_REQUIRED=1 --env NOTEAI_ENABLE_CLOUD_MODEL_MUTATION=0 --env NOTEAI_VIDEO_CACHE_DIR=/app/model/data/video_frames --env "PGOPTIONS=-c default_transaction_read_only=on -c statement_timeout=5000 -c lock_timeout=1000" --mount type=bind,src=/var/lib/noteai/data,dst=/app/model/data --publish 127.0.0.1:8000:8000 --restart no --log-driver local --log-opt max-size=10m --log-opt max-file=2 noteai-prod-shenzhen-registry-vpc.cn-shenzhen.cr.aliyuncs.com/noteai/app@sha256:612a7e57b8a4226e4c23be6267ee60fb79677cae9eb46ea1843aed11fc517620
ExecStop=/usr/bin/docker stop -t 30 noteai-api-f
ExecStopPost=-/usr/bin/docker rm -f noteai-api-f
Restart=always
RestartSec=5
SuccessExitStatus=0 137 143
TimeoutStopSec=45
KillMode=process

[Install]
WantedBy=multi-user.target
