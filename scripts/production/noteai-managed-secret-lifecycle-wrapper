#!/usr/bin/env bash
set -u
set -o pipefail
umask 077

program_name="${0##*/}"
case "${program_name}" in
    noteai-rotate-production-secrets)
        action=rotate
        ;;
    noteai-revoke-production-secrets)
        action=revoke
        ;;
    *)
        printf '%s\n' \
            'production_managed_secret_lifecycle=FAIL code=program_name'
        exit 2
        ;;
esac

implementation=/usr/local/lib/noteai/production_managed_secret_lifecycle.py
maintenance_image_ref=noteai-prod-shenzhen-registry-vpc.cn-shenzhen.cr.aliyuncs.com/noteai/app@sha256:c44354b5abfbb2b22f61e8db316d6abf9a44e805ba3ea3b64074508ff8562f1f
maintenance_image_id=sha256:0b13cd9cafe7de65d5a2754f7cd119cf6fcb822ab134b66a5009c06e08248504
test -f "${implementation}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_missing'
    exit 2
}
test ! -L "${implementation}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_symlink'
    exit 2
}
test "$(stat -c '%u:%g:%a' "${implementation}")" = "0:0:644" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_metadata'
    exit 2
}

actual_image_id="$(
    docker image inspect --format '{{.Id}}' "${maintenance_image_ref}" 2>/dev/null
)" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=maintenance_image_lookup'
    exit 2
}
test "${actual_image_id}" = "${maintenance_image_id}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=maintenance_image_identity'
    exit 2
}
existing="$(
    docker ps -a \
        --filter 'name=^/noteai-managed-secret-lifecycle-once$' \
        --format '{{.ID}}'
)" || exit 2
test -z "${existing}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=container_residue'
    exit 2
}

exec docker run \
    --rm \
    --pull never \
    --network host \
    --name noteai-managed-secret-lifecycle-once \
    --user 0:0 \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --pids-limit 64 \
    --memory 128m \
    --cpus 0.25 \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=8m \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -i \
    -v /etc/noteai:/etc/noteai:rw \
    -v "${implementation}:/task/production_managed_secret_lifecycle.py:ro" \
    --entrypoint python \
    "${maintenance_image_ref}" \
    /task/production_managed_secret_lifecycle.py \
    "${action}" \
    "$@"
