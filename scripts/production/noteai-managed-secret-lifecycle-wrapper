#!/usr/bin/env bash
set -u
set -o pipefail
umask 077

program_name="${0##*/}"
case "${program_name}" in
    noteai-rotate-production-secrets)
        action=rotate
        ;;
    noteai-revoke-production-secrets)
        action=revoke
        ;;
    *)
        printf '%s\n' \
            'production_managed_secret_lifecycle=FAIL code=program_name'
        exit 2
        ;;
esac

implementation=/usr/local/lib/noteai/production_managed_secret_lifecycle.py
test -f "${implementation}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_missing'
    exit 2
}
test ! -L "${implementation}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_symlink'
    exit 2
}
test "$(stat -c '%u:%g:%a' "${implementation}")" = "0:0:644" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=implementation_metadata'
    exit 2
}

api_container="$(
    docker ps \
        --filter label=com.noteai.runtime.role=api \
        --format '{{.ID}}'
)" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=api_image_lookup'
    exit 2
}
case "${api_container}" in
    "" | *$'\n'*)
        printf '%s\n' \
            'production_managed_secret_lifecycle=FAIL code=api_image_count'
        exit 2
        ;;
esac
image_id="$(
    docker inspect --format '{{.Image}}' "${api_container}" 2>/dev/null
)" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=api_image_inspect'
    exit 2
}
existing="$(
    docker ps -a \
        --filter 'name=^/noteai-managed-secret-lifecycle-once$' \
        --format '{{.ID}}'
)" || exit 2
test -z "${existing}" || {
    printf '%s\n' \
        'production_managed_secret_lifecycle=FAIL code=container_residue'
    exit 2
}

exec docker run \
    --rm \
    --pull never \
    --network host \
    --name noteai-managed-secret-lifecycle-once \
    --user 0:0 \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --pids-limit 64 \
    --memory 128m \
    --cpus 0.25 \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=8m \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -i \
    -v /etc/noteai:/etc/noteai:rw \
    -v "${implementation}:/task/production_managed_secret_lifecycle.py:ro" \
    --entrypoint python \
    "${image_id}" \
    /task/production_managed_secret_lifecycle.py \
    "${action}" \
    "$@"
