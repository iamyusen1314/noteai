{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noteai.local/schemas/golden_label_schema.v01.json",
  "title": "NoteAI Golden Label v0.1",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {
      "type": "string",
      "const": "golden-labels-v0.1"
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content_source", "labels"],
        "properties": {
          "id": {
            "type": "string"
          },
          "content_source": {
            "type": "object",
            "required": ["type", "file"],
            "properties": {
              "type": {
                "enum": ["quality_case", "json_fields", "inline"]
              },
              "file": {
                "type": "string"
              },
              "case_id": {
                "type": "string"
              },
              "title_field": {
                "type": "string"
              },
              "body_field": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "labels": {
            "type": "object",
            "required": [
              "human_quality_score",
              "delivery_ready",
              "naturalness_label",
              "fact_status",
              "ai_smell_level",
              "failure_tags"
            ],
            "properties": {
              "human_quality_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "delivery_ready": {
                "type": "boolean"
              },
              "naturalness_label": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "hook_quality": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "body_value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "industry_fit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "fact_status": {
                "enum": ["verified", "safe", "unknown", "overclaim"]
              },
              "ai_smell_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "failure_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
