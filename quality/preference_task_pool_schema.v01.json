{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noteai.local/schemas/preference_task_pool_schema.v01.json",
  "title": "NoteAI Preference Task Pool v0.1",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": {
      "type": "string",
      "const": "preference-task-pool-v0.1"
    },
    "description": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "domain", "task_status", "user_intent", "known_facts", "variant_slots"],
        "properties": {
          "task_id": {"type": "string"},
          "domain": {"type": "string"},
          "task_status": {
            "enum": ["needs_generation", "partial", "ready_for_pairing", "archived"]
          },
          "priority": {
            "enum": ["high", "medium", "normal"]
          },
          "source_case_id": {"type": "string"},
          "user_intent": {"type": "string"},
          "known_facts": {"type": "array", "items": {"type": "string"}},
          "fact_status": {
            "enum": ["verified", "safe", "unknown"]
          },
          "target_reader": {"type": "string"},
          "quality_focus": {"type": "array", "items": {"type": "string"}},
          "reference_title": {"type": "string"},
          "reference_body": {"type": "string"},
          "variant_slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slot_id", "origin", "status"],
              "properties": {
                "slot_id": {"type": "string"},
                "origin": {"type": "string"},
                "status": {
                  "enum": ["needs_generation", "ready", "skipped"]
                },
                "generation_route": {"type": "string"},
                "prompt_focus": {"type": "array", "items": {"type": "string"}},
                "source_file": {"type": "string"},
                "title_path": {"type": "string"},
                "body_path": {"type": "string"},
                "score_path": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
