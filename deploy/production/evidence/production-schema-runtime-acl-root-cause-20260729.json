  "root_cause": {
    "classification": "SOURCE_LEVEL_CONFIRMED",
    "v4_fixed_failure_stage": "apply_runtime_acl_failed",
    "first_failing_acl_substage": "role_contract",
    "database_schema_acl_reached": false,
    "mechanism": "The short-term managed-RDS privileged account was not a native PostgreSQL superuser. Creating six runtime roles therefore created six implicit runtime-role-to-creator membership rows with ADMIN true, INHERIT false and SET false. Together with the one accepted legacy noteai_xhs-to-noteai_admin row, the runtime membership count became seven while the old contract required exactly one.",
    "old_disposable_fixture_gap": "The previous integration used a native PostgreSQL superuser for role creation, so PostgreSQL did not create the six implicit ADMIN rows.",
    "unsafe_fix_rejected": "The six implicit rows are not treated as unexpected exceptions and are not granted to the short-term executor. They are bound to the persistent migration owner, which cannot inherit or SET ROLE through them.",
    "database_owner_follow_on_risk": "Running migrations directly as the short-term executor would make new objects depend on that account and could prevent deterministic account cleanup."
  },
