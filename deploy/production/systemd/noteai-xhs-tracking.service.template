[Unit]
Description=NoteAI production XHS Tracking singleton (default suspended)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=no
TimeoutStartSec=180
TimeoutStopSec=45
KillMode=process
SuccessExitStatus=137
Environment=DOCKER_CONTEXT=default
ExecStartPre=/usr/bin/test -f /etc/noteai/xhs-tracking.env
ExecStartPre=/usr/bin/test -d /var/lib/noteai/data
ExecStartPre=/usr/bin/docker image inspect @@NOTEAI_XHS_IMAGE@@
ExecStart=/usr/bin/docker run --log-driver=local --log-opt=max-size=10m --log-opt=max-file=2 --pull=never --rm --name=noteai-xhs-tracking --label=com.noteai.service=noteai-xhs-tracking --user=999:999 --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --network=bridge --ipc=private --memory=256m --cpus=0.25 --pids-limit=64 --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=512m,mode=1777,uid=999,gid=999 --mount=type=bind,src=/var/lib/noteai/data,dst=/app/model/data --env-file=/etc/noteai/xhs-tracking.env --env=NOTEAI_RUNTIME_ROLE=xhs-http --env=NOTEAI_DEPLOYMENT_STAGE=production --env=NOTEAI_CLOUD_RUNTIME=1 --env=NOTEAI_XHS_SERVICE=tracking --env=NOTEAI_SKIP_MODEL_ARTIFACT_CHECK=1 --env=NOTEAI_XHS_ACQUISITION_ADAPTER=spider_xhs_http --env=NOTEAI_XHS_COLLECTION_SUSPENDED=1 @@NOTEAI_XHS_IMAGE@@ python crawler_worker.py --loop --interval-minutes 60 --limit 50
ExecStartPost=/usr/bin/sleep 5
ExecStartPost=/usr/bin/docker exec noteai-xhs-tracking python crawler_worker.py --healthcheck
ExecStop=/usr/bin/docker container stop --time=30 noteai-xhs-tracking
ExecStopPost=-/usr/bin/docker container rm noteai-xhs-tracking

[Install]
WantedBy=multi-user.target
