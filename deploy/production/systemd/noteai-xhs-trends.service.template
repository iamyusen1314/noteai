[Unit]
Description=NoteAI production XHS Trends singleton (default suspended)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=no
TimeoutStartSec=180
TimeoutStopSec=45
KillMode=process
Environment=DOCKER_CONTEXT=default
ExecStartPre=/usr/bin/test -f /etc/noteai/xhs-trends.env
ExecStartPre=/usr/bin/docker image inspect @@NOTEAI_XHS_IMAGE@@
ExecStart=/usr/bin/docker run --pull=never --rm --name=noteai-xhs-trends --label=com.noteai.service=noteai-xhs-trends --user=999:999 --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --network=bridge --ipc=private --memory=512m --cpus=0.50 --pids-limit=64 --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=512m,mode=1777,uid=999,gid=999 --env-file=/etc/noteai/xhs-trends.env --env=NOTEAI_RUNTIME_ROLE=xhs-http --env=NOTEAI_DEPLOYMENT_STAGE=production --env=NOTEAI_CLOUD_RUNTIME=1 --env=NOTEAI_XHS_SERVICE=trends --env=NOTEAI_SKIP_MODEL_ARTIFACT_CHECK=1 --env=NOTEAI_XHS_ACQUISITION_ADAPTER=spider_xhs_http --env=NOTEAI_XHS_COLLECTION_SUSPENDED=1 --env=NOTEAI_XHS_FRESHNESS_REQUIRED=1 --env=NOTEAI_XHS_SEARCH_SEEDS_PER_CATEGORY=2 --env=NOTEAI_MARKET_TIMING_SNAPSHOT_UPLOAD_URL= @@NOTEAI_XHS_IMAGE@@ python market_timing_worker.py --daemon --interval 360
ExecStartPost=/usr/bin/docker exec noteai-xhs-trends python market_timing_worker.py --healthcheck
ExecStop=/usr/bin/docker container stop --time=30 noteai-xhs-trends

[Install]
WantedBy=multi-user.target
