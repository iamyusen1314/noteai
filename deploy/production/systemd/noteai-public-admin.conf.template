# Scoped override for the existing API-C Admin service. Keep its dedicated credential file.
[Service]
ExecStart=
ExecStart=/usr/bin/docker run --log-driver=local --log-opt=max-size=10m --log-opt=max-file=2 --pull=never --rm --name=noteai-admin-c --user=999:999 --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --network=bridge --ipc=private --memory=1024m --cpus=1 --pids-limit=128 --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m,mode=1777,uid=999,gid=999 --env-file=/etc/noteai/admin.env --env=PORT=8001 --env=WEB_CONCURRENCY=1 --env=NOTEAI_RUNTIME_ROLE=admin --env=NOTEAI_DEPLOYMENT_STAGE=production --env=NOTEAI_CLOUD_RUNTIME=1 --env=NOTEAI_ADMIN_CORS_ORIGINS=https://admin.noteaipro.com --env=NOTEAI_SKIP_MODEL_ARTIFACT_CHECK=1 --env=NOTEAI_MIGRATE_ON_START=0 --env=NOTEAI_API_STARTS_TREND_SCHEDULER=0 --env=PYTHON_DOTENV_DISABLED=1 --env=NOTEAI_TRUSTED_PROXY_IPS=172.17.0.1 --env="PGOPTIONS=-c default_transaction_read_only=off -c statement_timeout=10000 -c lock_timeout=5000" --volume=/var/lib/noteai/data:/app/model/data:ro --publish=127.0.0.1:8001:8001 @ADMIN_IMAGE@
