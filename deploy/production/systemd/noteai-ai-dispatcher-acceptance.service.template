[Unit]
Description=NoteAI one-shot exact Durable AI dispatcher acceptance
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=simple
Restart=no
RuntimeMaxSec=120
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=process
Environment=DOCKER_CONTEXT=default
ExecStartPre=/usr/bin/test -f /etc/noteai/ai-dispatcher.env
ExecStartPre=/usr/bin/docker image inspect @@NOTEAI_AI_WORKER_IMAGE@@
ExecStart=/usr/bin/docker run --pull=never --rm --name=noteai-ai-dispatcher-acceptance --label=com.noteai.acceptance=durable-ai-v1 --user=999:999 --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --network=bridge --ipc=private --memory=256m --cpus=0.25 --pids-limit=64 --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m,mode=1777,uid=999,gid=999 --env-file=/etc/noteai/ai-dispatcher.env --env=NOTEAI_RUNTIME_ROLE=ai-worker --env=NOTEAI_DEPLOYMENT_STAGE=production --env=NOTEAI_CLOUD_RUNTIME=1 --env=NOTEAI_SKIP_MODEL_ARTIFACT_CHECK=1 --env=NOTEAI_DURABLE_AI_COMPONENT=dispatcher --env=NOTEAI_DURABLE_AI_SUSPENDED=0 --env=NOTEAI_DURABLE_AI_ACCEPTANCE_MODE=1 --env=NOTEAI_DURABLE_AI_ACCEPTANCE_OPERATION_ID=@@NOTEAI_DURABLE_AI_ACCEPTANCE_OPERATION_ID@@ @@NOTEAI_AI_WORKER_IMAGE@@ python durable_ai_worker.py --dispatcher-once
ExecStop=/usr/bin/docker container stop --time=30 noteai-ai-dispatcher-acceptance
